# Copy to .env and fill in. Never commit .env.

# Google Calendar (setup: src/assistant/modules/calendar/README.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Space-separated calendar IDs; defaults to your main calendar
GOOGLE_CALENDAR_IDS=primary

# Telegram: token from @BotFather; chat id: send /start to your bot, it replies with it
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Phase 4: `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
